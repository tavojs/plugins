{
  "name": "@tavojs/analytics",
  "version": "1.0.0",
  "description": "Google Analytics and Google Tag Manager integration for Tavo.js apps.",
  "type": "module",
  "author": "Hrachya Martirosyan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tavojs/plugins.git",
    "directory": "packages/analytics"
  },
  "homepage": "https://tavojs.dev/docs/analytics",
  "bugs": {
    "url": "https://github.com/tavojs/plugins/issues"
  },
  "keywords": [
    "tavo",
    "analytics",
    "google-analytics",
    "google-tag-manager",
    "consent"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --import tsx tests/*.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "@tavojs/core": "^1.0.0"
  },
  "devDependencies": {
    "@tavojs/core": "^1.0.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "license": "MIT"
}
